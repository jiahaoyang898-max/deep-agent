# ============================================================
# 本地（非 Docker）开发用环境变量模板
#   用法: 复制为项目根目录的 .env 后按需修改。
#         cp .env.example .env
#   注意: 本地直连 MySQL 时 MYSQL_HOST=localhost，端口用 3306。
#         Docker 场景请用 docker/.env.docker（模板见 docker/.env.docker.example）。
# ============================================================

# ---------- 大模型（OpenAI 兼容接口）----------
DASHSCOPE_BASE_URL=https://your-llm-endpoint/v1
DASHSCOPE_API_KEY=sk-your-key
LLM_QWEN_PLUS=qwen3.6-flash

# ---------- 联网搜索 ----------
TAVILY_API_KEY=tvly-your-key

# ---------- MySQL（本地）----------
MYSQL_USER=root
MYSQL_PASSWORD=change-me-strong-password
MYSQL_DATABASE=pharma_db
MYSQL_HOST=localhost
MYSQL_PORT=3306

# ---------- RAGFlow 知识库 ----------
RAGFLOW_API_URL=http://your-ragflow-host
RAGFLOW_API_KEY=ragflow-your-key
# 知识库单次调用最长等待秒数（服务不可达时快速降级，不拖垮整条链路）
RAGFLOW_TIMEOUT=15

# ---------- 鉴权 / 跨域（backend 服务）----------
# AUTH_REQUIRED: 是否校验 auth 服务签发的 token，默认 true；仅排障时才设 false
# AUTH_SERVICE_URL: Docker 里由 compose 注入 http://auth:8001，本地直连用 http://127.0.0.1:8001
# CORS_ALLOW_ORIGINS: 逗号分隔的显式来源白名单；留空=不挂 CORS 中间件（网关下同源，无需跨域）
AUTH_REQUIRED=true
AUTH_SERVICE_URL=http://127.0.0.1:8001
CORS_ALLOW_ORIGINS=
