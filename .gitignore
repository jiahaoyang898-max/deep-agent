# ---- 敏感配置：绝不入库 ----
# .env / docker/.env.docker 含真实 API Key 与数据库密码，一律不跟踪。
# 首次使用请复制模板：cp .env.example .env
#                    cp docker/.env.docker.example docker/.env.docker
# 一键启动脚本会在缺失时自动从模板生成。
.env
.env.local
docker/.env.docker

# 环境文件备份：含真实密钥，一律不入库（sed -i.bak 等会产生）
.env.bak
.env.*.bak
docker/.env.docker.bak
*.env.bak
