# ============================================================
# Docker 环境变量模板
#   用法: 复制本文件为同目录下的 .env.docker，再填入你自己的密钥。
#         cp docker/.env.docker.example docker/.env.docker
#   docker-compose.yml 会把它作为 backend 的 env_file 注入容器。
#   注意: 容器内 agent 代码使用 load_dotenv(override=True)，
#         因此 MYSQL_HOST 必须写 compose 服务名 mysql，不能写 localhost。
# ============================================================

# ---------- 大模型（OpenAI 兼容接口）----------
DASHSCOPE_BASE_URL=https://your-llm-endpoint/v1
DASHSCOPE_API_KEY=sk-your-key
LLM_QWEN_PLUS=qwen3.6-flash

# ---------- 联网搜索 ----------
TAVILY_API_KEY=tvly-your-key

# ---------- MySQL（容器内网络，主机名固定为 mysql）----------
MYSQL_USER=root
MYSQL_PASSWORD=change-me-strong-password
MYSQL_DATABASE=pharma_db
MYSQL_HOST=mysql
MYSQL_PORT=3306

# ---------- RAGFlow 知识库 ----------
RAGFLOW_API_URL=http://your-ragflow-host
RAGFLOW_API_KEY=ragflow-your-key
